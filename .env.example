# Google OAuth Credentials
# Get these from Google Cloud Console: https://console.cloud.google.com/
AUTH_GOOGLE_CLIENT_ID=your-google-client-id-here
AUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# JWT Secret (generate a secure random string, at least 32 characters)
AUTH_JWT_SECRET=your-secure-jwt-secret-here

# CORS Origins (comma-separated for multiple)
AUTH_ALLOWED_ORIGINS=http://localhost:3000

# Service Client Credentials for internal API calls
AUTH_SERVICE_CLIENT_ID=palmery-internal-service
AUTH_SERVICE_CLIENT_SECRET=your-service-client-secret-here# Google OAuth Credentials
